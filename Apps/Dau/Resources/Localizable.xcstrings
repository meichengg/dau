            "state" : "translated",
            "value" : "Dấu vẫn còn trong nguồn đầu vào."
          }
        }
      }
    },
    "Dấu isn’t the current input source: choose “%@” from the Input menu or press %@, then try typing." : {
      "comment" : "Onboarding typing step. First %@ = the input source name as macOS shows it, in the system's language (D41, SystemUINames.dauInputSource); second %@ = the shortcut, e.g. ⌃Space.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu isn’t the current input source: choose “%@” from the Input menu or press %@, then try typing."
          }
