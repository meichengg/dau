{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ becomes %@" : {
      "comment" : "VoiceOver label of a typing example. First %@ = keys typed, second %@ = resulting text.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ becomes %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ thành %@"
          }
        }
      }
    },
    "%@ or 🌐" : {
      "comment" : "Shortcut in running text. %@ = key combination, e.g. ⌃Space; 🌐 = the Globe key.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ or 🌐"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hoặc 🌐"
          }
        }
      }
    },
    "%@ will quit, reopen, and ask whether to turn on Dấu. Click **%@**." : {
      "comment" : "First %@ = System Settings, second %@ = Allow, macOS's own names (D38).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will quit, reopen, and ask whether to turn on Dấu. Click **%@**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ đóng rồi mở lại và hỏi bạn có cho Dấu bật không. Bấm **%@**."
          }
        }
      }
    },
    "2 options, 1 on" : {
      "comment" : "Summary of the collapsed Advanced group: one of the two options is on.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 options, 1 on"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 tuỳ chọn, 1 đang bật"
          }
        }
      }
    },
    "2 options, both off" : {
      "comment" : "Summary of the collapsed Advanced group: both options are off.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 options, both off"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2 tuỳ chọn, đang tắt"
          }
        }
      }
    },
    "A V icon in the menu bar while you type Vietnamese" : {
      "comment" : "Onboarding step 2: the input mode icon.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A V icon in the menu bar while you type Vietnamese"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu tượng V trên thanh menu khi đang gõ tiếng Việt"
          }
        }
      }
    },
    "A word that is also Vietnamese stays Vietnamese: “%@” gives “%@”. To keep the letters you typed, press the mark key twice: “%@” gives “%@”." : {
      "comment" : "Smart Typing note. Each pair: keys typed, then the result (computed by the engine).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word that is also Vietnamese stays Vietnamese: “%@” gives “%@”. To keep the letters you typed, press the mark key twice: “%@” gives “%@”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ trùng với tiếng Việt thì tiếng Việt được ưu tiên: “%@” ra “%@”. Muốn giữ chữ gốc, gõ đúp phím dấu: “%@” ra “%@”."
          }
        }
      }
    },
    "Add" : {
