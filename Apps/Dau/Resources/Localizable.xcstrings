    "Choose Dấu from the Input menu, or press %@ to switch between Dấu and an English keyboard." : {
      "comment" : "%@ = the shortcut, e.g. ⌃Space.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Dấu from the Input menu, or press %@ to switch between Dấu and an English keyboard."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Dấu trên menu nguồn đầu vào, hoặc nhấn %@ để chuyển giữa Dấu và bàn phím tiếng Anh."
          }
        }
      }
    },
    "Choose Dấu from the Input menu, or press %@ to switch between Dấu and “%@”." : {
      "comment" : "First %@ = the shortcut, e.g. ⌃Space; second %@ = the English keyboard layout's name as macOS shows it, e.g. U.S.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Dấu from the Input menu, or press %@ to switch between Dấu and “%@”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn Dấu trên menu nguồn đầu vào, hoặc nhấn %@ để chuyển giữa Dấu và “%@”."
          }
        }
      }
    },
    "Choose Dấu from the Input menu." : {
      "comment" : "How to start typing with Dấu. Input menu = the input source menu in the menu bar.",
      "localizations" : {
