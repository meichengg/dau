    },
    "Follows macOS. Dấu switches to %@ when it reopens; until then it stays in %@." : {
      "comment" : "Subtitle of the Language row when Dấu follows the macOS language list, which changed while Dấu was open (macOS asks to relaunch and never does it by itself). First %@ = the language Dấu uses after reopening, second %@ = the language it shows now; each named in its own language (“English”, “Tiếng Việt”), as the row's value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follows macOS. Dấu switches to %1$@ when it reopens; until then it stays in %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo macOS. Dấu dùng %1$@ sau khi mở lại; đến lúc đó vẫn hiện %2$@."
          }
