          }
        }
      }
    },
    "Dấu isn’t turned on in your input sources" : {
      "comment" : "Banner title: Dấu is not among the enabled input sources.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu isn’t turned on in your input sources"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu chưa được bật trong nguồn đầu vào"
          }
        }
      }
    },
    "Dấu never sends what you type off your Mac. The input method has no network access; only the updater connects, to download new versions and the app compatibility list. Open source under the GPLv3 license." : {
      "comment" : "Privacy note at the bottom of the page. Wording fixed by docs/UI.md (D8, N2): translate without adding or removing promises.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu never sends what you type off your Mac. The input method has no network access; only the updater connects, to download new versions and the app compatibility list. Open source under the GPLv3 license."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu không gửi chữ bạn gõ ra khỏi máy. Bộ gõ không có quyền truy cập mạng; chỉ phần cập nhật kết nối để tải bản mới và danh sách ứng dụng tương thích. Mã nguồn mở theo giấy phép GPLv3."
          }
        }
      }
    },
