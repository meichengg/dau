      }
    },
    "Follows macOS. To set a language for Dấu only, click Change…, then under %@ click + and choose Dấu." : {
      "comment" : "Subtitle of the Language row when macOS picks Dấu's language from the system's list. %@ = macOS's own name of the Applications section of Language & Region, in the system language (D38). “Change…” is the row's button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
