        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi bất cứ lúc nào trong Cài đặt Dấu."
          }
        }
      }
    },
    "You can remove “%@” in %@, then try again." : {
      "comment" : "Uninstall failed. First %@ = the input source name as macOS shows it, in the system's language (D41, SystemUINames.dauInputSource); second %@ = System Settings › Keyboard › Input Sources (D38).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can remove “%@” in %@, then try again."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể bỏ “%@” trong %@, rồi thử lại."
          }
        }
      }
    },
    "You can still change settings, but you can’t type Vietnamese yet." : {
      "comment" : "Banner subtitle.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still change settings, but you can’t type Vietnamese yet."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn vẫn chỉnh được cài đặt, nhưng chưa gõ được tiếng Việt."
          }
        }
      }
    },
    "You’ll remove Dấu from %@ in %@. Then the input method is moved to %@." : {
      "comment" : "Alert text. %@ in order: Input Sources, System Settings, Trash — macOS's own names (D38).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll remove Dấu from %@ in %@. Then the input method is moved to %@."
